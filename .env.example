# LoanTrack environment example - DUMMY VALUES ONLY.
#
#   cp .env.example .env        (.env is git-ignored; never commit it)
#   docker compose up -d
#
# These values work unchanged with Docker Compose: the backend reaches
# PostgreSQL by its service name "postgres" on the internal port 5432.
# Change the password in your own .env; never put real credentials here.

# --- PostgreSQL container (read by the official postgres image) ---
POSTGRES_DB=loantrack
POSTGRES_USER=loantrack_user
POSTGRES_PASSWORD=change_me_dummy_password

# --- Backend: where the database is ---
# Docker Compose / Kubernetes: service name + internal port 5432.
DB_HOST=postgres
DB_PORT=5432

# Optional full connection string. If non-empty it OVERRIDES DB_HOST, DB_PORT
# and POSTGRES_*. Leave it empty for Docker Compose.
# For local host testing against a PostgreSQL published on localhost:5433,
# set it in your shell instead, e.g.:
#   DATABASE_URL=postgresql://loantrack_user:change_me_dummy_password@localhost:5433/loantrack
DATABASE_URL=

# --- Backend: connection pool and startup retry ---
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SECONDS=3
DB_RETRY_BASE_SECONDS=0.5
DB_RETRY_MAX_SECONDS=30

# --- Backend: version reported in the X-App-Version header ---
APP_VERSION=v1

# HOSTNAME (sent as X-Served-By) is set automatically by Docker/Kubernetes
# to the container/pod name. Do NOT set it here, or every replica reports the same name.

# Backend integration tests only (not used by the app), local host database:
#   TEST_DATABASE_URL=postgresql://loantrack_user:change_me_dummy_password@localhost:5433/loantrack
